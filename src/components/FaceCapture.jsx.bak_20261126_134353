import { useEffect, useRef, useState } from 'react'
import * as faceapi from '@vladmandic/face-api'
import { loadFaceModels } from '../lib/faceMatch'

const DETECT_INTERVAL_MS = 400
const STABLE_FRAMES_TO_CAPTURE = 3
const SCORE_THRESHOLD = 0.55

export default function FaceCapture({ open, onClose, onCapture, title = 'Face Capture' }) {
  const videoRef = useRef(null)
  const canvasRef = useRef(null)
  const streamRef = useRef(null)
  const loopRef = useRef(null)
  const stableRef = useRef(0)
  const capturedRef = useRef(false)
  const captureFrameRef = useRef(null)

  const [error, setError] = useState(null)
  const [ready, setReady] = useState(false)
  const [status, setStatus] = useState('starting')
  const [faceDetected, setFaceDetected] = useState(false)
  const [snapshot, setSnapshot] = useState(null)
  const [progress, setProgress] = useState(0)

  useEffect(() => {
    if (!open) return
    let cancelled = false

    async function start() {
      try {
        setError(null); setStatus('starting'); setSnapshot(null); setProgress(0)
        capturedRef.current = false; stableRef.current = 0
        await loadFaceModels()
        const stream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: 'user', width: { ideal: 640 }, height: { ideal: 480 } },
          audio: false,
        })
        if (cancelled) { stream.getTracks().forEach(t => t.stop()); return }
        streamRef.current = stream
        const v = videoRef.current
        if (v) {
          v.srcObject = stream
          await v.play()
          setReady(true)
          setStatus('searching')
        }
      } catch (e) {
        const msg = e?.name === 'NotAllowedError'
          ? 'Camera permission denied. Allow camera access in your browser settings and reload.'
          : e?.name === 'NotFoundError'
          ? 'No camera detected on this device.'
          : 'Could not start camera: ' + (e?.message || 'unknown')
        setError(msg)
      }
    }

    start()
    return () => {
      cancelled = true
      clearInterval(loopRef.current)
      streamRef.current?.getTracks().forEach(t => t.stop())
      streamRef.current = null
      setReady(false)
    }
  }, [open])

  useEffect(() => {
    if (!ready || !open) return
    clearInterval(loopRef.current)

    loopRef.current = setInterval(async () => {
      const v = videoRef.current
      if (!v || capturedRef.current) return
      if (v.readyState < 2 || !v.videoWidth) return

      try {
        const options = new faceapi.TinyFaceDetectorOptions({ inputSize: 320, scoreThreshold: SCORE_THRESHOLD })
        const det = await faceapi.detectSingleFace(v, options)
        if (det && det.score >= SCORE_THRESHOLD) {
          stableRef.current++
          setFaceDetected(true)
          setProgress(Math.min(100, (stableRef.current / STABLE_FRAMES_TO_CAPTURE) * 100))
          setStatus('holding')
          if (stableRef.current >= STABLE_FRAMES_TO_CAPTURE) {
            setStatus('captured')
            captureFrameRef.current?.()
          }
        } else {
          stableRef.current = 0
          setFaceDetected(false)
          setProgress(0)
          setStatus('searching')
        }
      } catch {
        // ignore transient detection errors
      }
    }, DETECT_INTERVAL_MS)

    return () => { clearInterval(loopRef.current) }
  }, [ready, open])

  function captureFrame() {
    if (capturedRef.current) return
    capturedRef.current = true
    const v = videoRef.current, c = canvasRef.current
    if (!v || !c) return
    c.width = v.videoWidth
    c.height = v.videoHeight
    const ctx = c.getContext('2d')
    ctx.translate(c.width, 0); ctx.scale(-1, 1)
    ctx.drawImage(v, 0, 0)
    const dataUrl = c.toDataURL('image/jpeg', 0.88)
    setSnapshot(dataUrl)
    clearInterval(loopRef.current)
    streamRef.current?.getTracks().forEach(t => t.stop())
    streamRef.current = null
    setTimeout(() => {
      onCapture(dataUrl)
      onClose?.()
    }, 700)
  }

  captureFrameRef.current = captureFrame

  function manualCapture() {
    if (ready && !capturedRef.current) captureFrame()
  }

  function retry() {
    setSnapshot(null)
    setStatus('starting')
    setProgress(0)
    stableRef.current = 0
    capturedRef.current = false
    setFaceDetected(false)
    navigator.mediaDevices.getUserMedia({
      video: { facingMode: 'user', width: { ideal: 640 }, height: { ideal: 480 } },
      audio: false,
    }).then(stream => {
      streamRef.current = stream
      const v = videoRef.current
      if (v) { v.srcObject = stream; v.play() }
      setReady(true)
      setStatus('searching')
    }).catch(() => setError('Could not restart camera.'))
  }

  if (!open) return null

  return (
    <div className="face-capture-backdrop" role="dialog" aria-modal="true">
      <div className="face-capture face-capture-live">
        <header>
          <h3>{title}</h3>
          <button onClick={onClose} aria-label="Close">x</button>
        </header>

        {error ? (
          <div className="face-capture__error">{error}</div>
        ) : (
          <div className="face-capture__stage">
            {snapshot ? (
              <img src={snapshot} alt="Captured face" />
            ) : (
              <>
                <video ref={videoRef} muted playsInline autoPlay />
                <div className={'face-oval' + (faceDetected ? ' is-detected' : '')} aria-hidden="true" />
                {faceDetected && (
                  <div className="face-detected-badge">
                    <span className="face-detected-dot" />
                    <span>Face detected</span>
                  </div>
                )}
                <div className="face-status">
                  {status === 'starting' && 'Starting camera...'}
                  {status === 'searching' && 'Center your face in the oval'}
                  {status === 'holding' && 'Hold still...'}
                  {status === 'captured' && 'Captured!'}
                </div>
                {progress > 0 && status !== 'captured' && (
                  <div className="face-progress">
                    <div className="face-progress-bar" style={{ width: progress + '%' }} />
                  </div>
                )}
              </>
            )}
          </div>
        )}

        <canvas ref={canvasRef} hidden />

        <footer>
          {snapshot ? (
            <button className="btn-ghost" onClick={retry}>Retake</button>
          ) : (
            <>
              <button className="btn-ghost" onClick={onClose}>Cancel</button>
              <button className="btn-primary" onClick={manualCapture} disabled={!ready}>
                Capture Now
              </button>
            </>
          )}
        </footer>
      </div>
    </div>
  )
}