import { useEffect, useMemo, useState } from 'react'
import { useNavigate } from 'react-router-dom'
import Papa from 'papaparse'
import { supabase } from '../lib/supabase'
import Logo from '../components/Logo'

const REQUIRED = ['first_name', 'last_name', 'gender', 'id_type', 'id_number', 'dob', 'county', 'constituency', 'ward', 'polling_station']
const OPTIONAL = ['middle_name', 'verified_at']
const ALL_COLS = [...REQUIRED, ...OPTIONAL]

const NAME_RE = /^[A-Za-z][A-Za-z '-]*$/
const PASSPORT_RE = /^[A-Z]\d{7}$/

function validateRow(row, idx) {
  const errors = []
  if (!row.first_name?.trim()) errors.push('first_name: required')
  else if (!NAME_RE.test(row.first_name.trim())) errors.push('first_name: invalid characters')
  if (row.middle_name && !NAME_RE.test(row.middle_name.trim())) errors.push('middle_name: invalid characters')
  if (!row.last_name?.trim()) errors.push('last_name: required')
  else if (!NAME_RE.test(row.last_name.trim())) errors.push('last_name: invalid characters')

  if (!['male', 'female', 'other'].includes(row.gender)) errors.push('gender: must be male/female/other')

  if (!['national_id', 'passport'].includes(row.id_type)) errors.push('id_type: must be national_id or passport')
  else {
    const id = (row.id_number || '').trim()
    if (!id) errors.push('id_number: required')
    else if (row.id_type === 'national_id') {
      if (!/^\d{7,9}$/.test(id)) errors.push('id_number: 7-9 digits for national_id')
    } else if (!PASSPORT_RE.test(id)) errors.push('id_number: format A1234567 for passport')
  }

  if (!row.dob?.trim()) errors.push('dob: required')
  else {
    const d = new Date(row.dob)
    if (isNaN(d.getTime())) errors.push('dob: invalid date')
    else {
      const age = (Date.now() - d.getTime()) / (365.25 * 24 * 60 * 60 * 1000)
      if (age < 18) errors.push('dob: must be 18+')
    }
  }

  for (const f of ['county', 'constituency', 'ward', 'polling_station']) {
    if (!row[f]?.trim()) errors.push(f + ': required')
  }

  return { idx, row, errors }
}

export default function AdminVoterUpload() {
  const navigate = useNavigate()
  const [fileName, setFileName] = useState('')
  const [rows, setRows] = useState([])
  const [existingIds, setExistingIds] = useState(new Set())
  const [markVerified, setMarkVerified] = useState(true)
  const [countyFilter, setCountyFilter] = useState('')
  const [uploading, setUploading] = useState(false)
  const [progress, setProgress] = useState({ done: 0, total: 0 })
  const [result, setResult] = useState(null)
  const [error, setError] = useState('')

  useEffect(() => {
    (async () => {
      const PAGE = 1000
      const ids = new Set()
      let from = 0
      for (let i = 0; i < 100; i++) {
        const { data } = await supabase.from('voters').select('id_number').range(from, from + PAGE - 1)
        if (!data || data.length === 0) break
        data.forEach(r => r.id_number && ids.add(r.id_number))
        if (data.length < PAGE) break
        from += PAGE
      }
      setExistingIds(ids)
    })()
  }, [])

  function handleFile(e) {
    const file = e.target.files?.[0]
    if (!file) return
    setFileName(file.name)
    setResult(null); setError('')

    Papa.parse(file, {
      header: true,
      skipEmptyLines: 'greedy',
      transformHeader: h => h.trim().toLowerCase().replace(/\s+/g, '_'),
      complete: (res) => {
        const parsed = res.data.filter(r => Object.values(r).some(v => v && String(v).trim()))
        setRows(parsed.map((r, i) => ({ _idx: i, ...r })))
      },
      error: (err) => setError('CSV parse error: ' + err.message),
    })
  }

  const analysis = useMemo(() => {
    if (rows.length === 0) return { valid: [], errors: [], dupes: [], missingCols: [] }

    const cols = Object.keys(rows[0] || {})
    const missingCols = REQUIRED.filter(c => !cols.includes(c))

    const valid = []
    const errors = []
    const dupes = []
    const seen = new Set()

    rows.forEach((r, i) => {
      if (countyFilter && r.county?.trim() !== countyFilter) return
      const v = validateRow(r, i)
      if (v.errors.length > 0) { errors.push(v); return }
      const id = r.id_number.trim()
      if (existingIds.has(id)) { dupes.push({ idx: i, id }); return }
      if (seen.has(id)) { dupes.push({ idx: i, id, inFile: true }); return }
      seen.add(id)
      valid.push(r)
    })

    return { valid, errors, dupes, missingCols }
  }, [rows, existingIds, countyFilter])

  async function handleUpload() {
    if (analysis.valid.length === 0) return
    setUploading(true); setProgress({ done: 0, total: analysis.valid.length }); setError('')

    const { data: { user } } = await supabase.auth.getUser()
    const nowIso = new Date().toISOString()

    const toInsert = analysis.valid.map(r => ({
      first_name: r.first_name.trim(),
      middle_name: r.middle_name?.trim() || null,
      last_name: r.last_name.trim(),
      gender: r.gender,
      id_type: r.id_type,
      id_number: r.id_number.trim(),
      dob: r.dob.trim(),
      county: r.county.trim(),
      constituency: r.constituency.trim(),
      ward: r.ward.trim(),
      polling_station: r.polling_station.trim(),
      registered_by: user?.id ?? null,
      verified_at: r.verified_at?.trim() || (markVerified ? nowIso : null),
    }))

    const BATCH = 200
    let inserted = 0
    const failures = []

    for (let i = 0; i < toInsert.length; i += BATCH) {
      const batch = toInsert.slice(i, i + BATCH)
      const { data, error: err } = await supabase.from('voters').insert(batch).select('id')
      if (err) {
        failures.push({ from: i, error: err.message })
      } else {
        inserted += (data?.length || batch.length)
      }
      setProgress({ done: Math.min(i + BATCH, toInsert.length), total: toInsert.length })
    }

    setUploading(false)
    setResult({ inserted, failed: failures.length, failures })
  }

  function reset() {
    setFileName(''); setRows([]); setResult(null); setError('')
  }

  const counties = useMemo(() => Array.from(new Set(rows.map(r => r.county).filter(Boolean))).sort(), [rows])

  return (
    <div className="admin">
      <header className="admin-header">
        <Logo size={36} showText />
        <div className="admin-header-right">
          <button className="btn-ghost" onClick={() => navigate('/admin')}>Back</button>
        </div>
      </header>

      <main className="admin-main">
        <div className="admin-title-row">
          <div>
            <h1>Upload Voter CSV</h1>
            <p className="muted">Import voters in bulk. Duplicates and invalid rows are skipped automatically.</p>
          </div>
        </div>

        {!result && (
          <section className="upload-card">
            <label className="upload-dropzone">
              <input type="file" accept=".csv,text/csv" onChange={handleFile} hidden />
              <div className="upload-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                  <polyline points="17 8 12 3 7 8" />
                  <line x1="12" y1="3" x2="12" y2="15" />
                </svg>
              </div>
              <strong>{fileName || 'Choose a CSV file'}</strong>
              <span className="muted">Required columns: {REQUIRED.join(', ')}</span>
            </label>

            {rows.length > 0 && (
              <>
                <div className="upload-summary">
                  <div className="upload-stat is-ok"><span>{analysis.valid.length}</span><small>Ready</small></div>
                  <div className="upload-stat is-warn"><span>{analysis.dupes.length}</span><small>Duplicates</small></div>
                  <div className="upload-stat is-err"><span>{analysis.errors.length}</span><small>Errors</small></div>
                </div>

                <div className="upload-controls">
                  <label>
                    Filter by county
                    <select value={countyFilter} onChange={e => setCountyFilter(e.target.value)}>
                      <option value="">All counties</option>
                      {counties.map(c => <option key={c} value={c}>{c}</option>)}
                    </select>
                  </label>
                  <label className="upload-checkbox">
                    <input type="checkbox" checked={markVerified} onChange={e => setMarkVerified(e.target.checked)} />
                    Mark imported voters as verified
                  </label>
                </div>

                {analysis.missingCols.length > 0 && (
                  <div className="form-error">Missing columns: {analysis.missingCols.join(', ')}</div>
                )}

                {analysis.errors.length > 0 && (
                  <details className="upload-details">
                    <summary>{analysis.errors.length} rows with validation errors</summary>
                    <ul>
                      {analysis.errors.slice(0, 20).map((e, i) => (
                        <li key={i}>Row {e.idx + 2}: {e.errors.join('; ')}</li>
                      ))}
                    </ul>
                  </details>
                )}

                {analysis.dupes.length > 0 && (
                  <details className="upload-details">
                    <summary>{analysis.dupes.length} duplicate rows (skipped)</summary>
                    <ul>
                      {analysis.dupes.slice(0, 20).map((d, i) => (
                        <li key={i}>Row {d.idx + 2}: ID {d.id} {d.inFile ? '(duplicate in file)' : '(already in database)'}</li>
                      ))}
                    </ul>
                  </details>
                )}

                {analysis.valid.length > 0 && (
                  <div className="upload-preview">
                    <h3>Preview (first 10 valid rows)</h3>
                    <div className="table-wrap">
                      <table className="officers-table">
                        <thead>
                          <tr><th>Name</th><th>ID</th><th>County</th><th>Ward</th></tr>
                        </thead>
                        <tbody>
                          {analysis.valid.slice(0, 10).map((r, i) => (
                            <tr key={i}>
                              <td>{r.first_name} {r.last_name}</td>
                              <td>{r.id_number}</td>
                              <td>{r.county}</td>
                              <td>{r.ward}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </div>
                )}

                {uploading && (
                  <div className="upload-progress">
                    <div className="upload-progress-bar" style={{ width: (progress.done / Math.max(1, progress.total)) * 100 + '%' }} />
                    <span>{progress.done} / {progress.total}</span>
                  </div>
                )}

                <div className="upload-actions">
                  <button className="btn-ghost" onClick={reset} disabled={uploading}>Cancel</button>
                  <button className="btn-primary" disabled={uploading || analysis.valid.length === 0} onClick={handleUpload}>
                    {uploading ? 'Uploading...' : `Import ${analysis.valid.length} voter${analysis.valid.length === 1 ? '' : 's'}`}
                  </button>
                </div>
              </>
            )}

            {error && <div className="form-error">{error}</div>}
          </section>
        )}

        {result && (
          <section className="upload-card upload-result">
            <div className="upload-result-icon" aria-hidden="true">
              {result.inserted > 0 ? (
                <svg viewBox="0 0 52 52" className="tick" width="80" height="80">
                  <circle cx="26" cy="26" r="24" fill="none" stroke="#059669" strokeWidth="3" />
                  <path d="M14 27 L23 36 L39 18" fill="none" stroke="#059669" strokeWidth="4" strokeLinecap="round" strokeLinejoin="round" />
                </svg>
              ) : (
                <svg viewBox="0 0 52 52" width="80" height="80">
                  <circle cx="26" cy="26" r="24" fill="none" stroke="#dc2626" strokeWidth="3" />
                  <path d="M17 17 L35 35 M35 17 L17 35" fill="none" stroke="#dc2626" strokeWidth="4" strokeLinecap="round" />
                </svg>
              )}
            </div>
            <h2>{result.inserted} voter{result.inserted === 1 ? '' : 's'} imported</h2>
            {result.failed > 0 && <p className="muted">{result.failed} batch{result.failed === 1 ? '' : 'es'} failed</p>}
            {result.failures.length > 0 && (
              <details className="upload-details">
                <summary>Failed batches</summary>
                <ul>{result.failures.map((f, i) => <li key={i}>From row {f.from}: {f.error}</li>)}</ul>
              </details>
            )}
            <div className="upload-actions">
              <button className="btn-ghost" onClick={reset}>Upload another file</button>
              <button className="btn-primary" onClick={() => navigate('/admin/voters')}>View all voters</button>
            </div>
          </section>
        )}
      </main>
    </div>
  )
}